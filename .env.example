# Copy to .env (or server/.env) and fill in real values. Never commit the real .env.

# Gmail SMTP for automatic bills. Use a Gmail App Password (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal Gmail password.
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_FROM_NAME=UdyogConnect

# Server
# MONGODB_URI=mongodb+srv://user:password@cluster/udyogconnect
# JWT_SECRET=change_me_to_a_long_random_string
# CLIENT_URL=http://localhost:5174

# Stripe card payments (optional; without a key card payments are disabled in production)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# eSewa (multi-vendor). Each business saves its own merchant code + secret key in
# Seller Dashboard > Profile > Payment Settings; secrets are encrypted with this key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later makes saved merchant secrets unreadable (businesses must reconnect).
# PAYMENT_ENCRYPTION_KEY=64_hex_characters
# sandbox (rc-epay.esewa.com.np, test merchant EPAYTEST) or live (epay.esewa.com.np, requires HTTPS)
ESEWA_ENV=sandbox
