# Copy to .env (or server/.env) and fill in real values. Never commit the real .env.

# Gmail SMTP for automatic bills. Use a Gmail App Password (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal Gmail password.
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_FROM_NAME=UdyogConnect

# Any other SMTP provider instead of Gmail (used for bills and password reset emails):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=no-reply@example.com
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_FROM="UdyogConnect <no-reply@example.com>"

# Render's free plan blocks SMTP (Gmail included), so production email must use an HTTPS API.
# Brevo (brevo.com, free 300 emails/day): create an API key and verify your sender address,
# then set both on Render. When BREVO_API_KEY is set it is used instead of SMTP.
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM="UdyogConnect <yourgmail@gmail.com>"

# Website address used in password reset links. Production defaults to the live site:
# FRONTEND_URL=https://udyog-connect-lyart.vercel.app
# Locally it can stay unset; links then use the dev site (http://localhost:5174).
# FRONTEND_URL=http://localhost:5174

# Server
# MONGODB_URI=mongodb+srv://user:password@cluster/udyogconnect
# JWT_SECRET=change_me_to_a_long_random_string

# Stripe card payments (optional; without a key card payments are disabled in production)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# eSewa (multi-vendor). Each business saves its own merchant code + secret key in
# Seller Dashboard > Profile > Payment Settings; secrets are encrypted with this key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later makes saved merchant secrets unreadable (businesses must reconnect).
# PAYMENT_ENCRYPTION_KEY=64_hex_characters
# sandbox (rc-epay.esewa.com.np, test merchant EPAYTEST) or live (epay.esewa.com.np, requires HTTPS)
ESEWA_ENV=sandbox
